{
  "name": "n8n-nodes-harmony",
  "version": "0.1.1",
  "description": "n8n node for Harmony: manage tickets, desks, employees, assets, applications, the service catalog and AI requests",
  "license": "MIT",
  "homepage": "https://github.com/harmonyso/n8n-nodes-harmony#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "harmony",
    "itsm",
    "service desk",
    "helpdesk",
    "it automation"
  ],
  "author": {
    "name": "Ben Tibi",
    "email": "ben@harmony.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harmonyso/n8n-nodes-harmony.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/HarmonyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Harmony/Harmony.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.56.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
